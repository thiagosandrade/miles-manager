{
  "Jwt": {
    "Issuer": "MilesManager",
    "Audience": "MilesManagerFrontend",
    "Key": "change-this-development-key-to-a-long-random-secret",
    "AccessTokenMinutes": 120
  },
  "Email": {
    "ApiKey": "YOUR_RESEND_API_KEY",
    "From": "Miles Manager <onboarding@resend.dev>"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:4200"
  },
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Port=5432;Database=milesmanager;Username=postgres;Password=postgres"
  },
  "Alerts": {
    "IngestionJobEnabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
